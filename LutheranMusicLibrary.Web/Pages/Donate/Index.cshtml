@page "/donate"
@model LutheranMusicLibrary.Web.Pages.Donate.IndexModel
@{ ViewData["Title"] = "Support Hymn Desk"; }

<div class="page-header">
    <h1>Support Hymn Desk</h1>
</div>

<div class="homepage-intro" style="text-align:left; max-width:640px;">
    <p>
        Hymn Desk is a one-person passion project — no ads, no subscription, no institutional backing.
        Hosting and domain costs come straight out of pocket. If this site has been useful to you and
        you'd like to help keep it running, any of the options below are appreciated, but never expected.
    </p>

    <div class="donate-options">
        <a href="#" class="donate-btn">☕ Ko-fi — [add your Ko-fi link]</a>
        <a href="#" class="donate-btn">PayPal — [add your PayPal.me link]</a>
        <a href="#" class="donate-btn">Venmo — [add your @@Venmo handle]</a>
        <a href="#" class="donate-btn">Cash App — [add your $Cashtag]</a>
        <p class="donate-note">Zelle — [add the email/phone you use for Zelle, since Zelle has no shareable link]</p>
    </div>

    <p class="donate-note">
        Every dollar goes toward hosting, the database, and the time spent keeping the catalog accurate.
        Thank you for using Hymn Desk.
    </p>
</div>
