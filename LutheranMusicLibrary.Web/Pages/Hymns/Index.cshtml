@page "/hymns"
@model LutheranMusicLibrary.Web.Pages.Hymns.IndexModel
@{
    ViewData["Title"] = "Hymn Texts";
    var baseQuery = $"/hymns?q={Uri.EscapeDataString(Model.Query)}&season={Uri.EscapeDataString(Model.Season)}&meter={Uri.EscapeDataString(Model.Meter)}&sort={Uri.EscapeDataString(Model.Sort)}";
}

<div class="page-header">
    <h1>Hymn Texts</h1>
    <p class="page-subtitle">
        @Model.Result.TotalCount.ToString("N0") entries
        @if (Model.Result.TotalPages > 1)
        {
            <text> · page @Model.Result.Page of @Model.Result.TotalPages</text>
        }
        · Browse the complete catalog of Lutheran hymn texts
        · <a href="/hymns/random">Random hymn →</a>
    </p>
</div>

<div class="filter-bar">
    <form method="get" class="filter-form">
        <input type="search" name="q" value="@Model.Query" placeholder="Search titles, authors, first lines…" class="filter-input" />
        <select name="season" class="filter-select">
            <option value="">All Seasons</option>
            <option value="Advent" selected="@(Model.Season=="Advent")">Advent</option>
            <option value="Christmas" selected="@(Model.Season=="Christmas")">Christmas</option>
            <option value="Epiphany" selected="@(Model.Season=="Epiphany")">Epiphany</option>
            <option value="Lent" selected="@(Model.Season=="Lent")">Lent</option>
            <option value="Easter" selected="@(Model.Season=="Easter")">Easter</option>
            <option value="Pentecost" selected="@(Model.Season=="Pentecost")">Pentecost</option>
            <option value="Reformation" selected="@(Model.Season=="Reformation")">Reformation</option>
        </select>
        <select name="sort" class="filter-select">
            <option value="" selected="@(Model.Sort=="")">Sort: Title</option>
            <option value="year" selected="@(Model.Sort=="year")">Sort: Year</option>
        </select>
        @if (!string.IsNullOrEmpty(Model.Meter))
        {
            <input type="hidden" name="meter" value="@Model.Meter" />
        }
        <button type="submit" class="filter-btn">Filter</button>
        @if (!string.IsNullOrEmpty(Model.Query) || !string.IsNullOrEmpty(Model.Season) || !string.IsNullOrEmpty(Model.Meter) || !string.IsNullOrEmpty(Model.Sort))
        {
            <a href="/hymns" class="filter-clear">Clear</a>
        }
    </form>
    @if (!string.IsNullOrEmpty(Model.Meter))
    {
        <p class="filter-active-note">Showing hymns in meter <strong>@Model.Meter</strong> — <a href="/hymns?q=@Model.Query&amp;season=@Model.Season">remove this filter</a></p>
    }
</div>

@if (Model.Result.Items.Count == 0)
{
    <p class="empty-state">No hymns match that search. Try a different word, or <a href="/hymns">clear the filters</a>.</p>
}

<div class="catalog-grid">
    @foreach (var hymn in Model.Result.Items)
    {
        <a href="/hymns/@hymn.Slug" class="catalog-card">
            <div class="card-title">@hymn.Title</div>
            @if (!string.IsNullOrEmpty(hymn.FirstLine))
            {
                <div class="card-subtitle">@hymn.FirstLine</div>
            }
            <div class="card-meta">
                @if (!string.IsNullOrEmpty(hymn.Author))
                {
                    <span>@hymn.Author</span>
                }
                @if (hymn.Year > 0)
                {
                    <span class="meta-sep">·</span>
                    <span>@hymn.Year</span>
                }
                @if (!string.IsNullOrEmpty(hymn.Meter))
                {
                    <span class="meta-sep">·</span>
                    <span class="meta-meter">@hymn.Meter</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(hymn.HymnalRefs))
            {
                <div class="card-hymnals">@hymn.HymnalRefs</div>
            }
        </a>
    }
</div>

<partial name="_Pagination" model="@(new PaginationInfo { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages, BaseQuery = baseQuery })" />
