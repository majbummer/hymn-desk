@page "/resources"
@model LutheranMusicLibrary.Web.Pages.Resources.IndexModel
@{ ViewData["Title"] = "Resources"; }

<div class="page-header">
    <h1>Resources</h1>
    <p class="page-subtitle">
        Hymn Desk isn't affiliated with any of the sites below — they're just the places I actually
        turn to for scripture, scores, and recordings, gathered in one spot for convenience.
    </p>
</div>

<div class="resources-groups">
    <div class="resources-group">
        <h2>Scripture &amp; Reference</h2>
        <ul class="plain-list">
            <li><a href="https://www.biblegateway.com" target="_blank" rel="noopener">Bible Gateway ↗</a></li>
            <li><a href="https://hymnary.org" target="_blank" rel="noopener">Hymnary.org ↗</a></li>
            <li><a href="https://www.bach-cantatas.com" target="_blank" rel="noopener">Bach Cantatas Website ↗</a></li>
            <li><a href="https://www.bookofconcord.org" target="_blank" rel="noopener">Book of Concord ↗</a></li>
        </ul>
    </div>

    <div class="resources-group">
        <h2>Free Sheet Music</h2>
        <ul class="plain-list">
            <li><a href="https://imslp.org" target="_blank" rel="noopener">IMSLP / Petrucci Music Library ↗</a></li>
            <li><a href="https://www.cpdl.org" target="_blank" rel="noopener">CPDL / ChoralWiki ↗</a></li>
        </ul>
    </div>

    <div class="resources-group">
        <h2>Audio</h2>
        <ul class="plain-list">
            <li><a href="https://www.youtube.com" target="_blank" rel="noopener">YouTube ↗</a></li>
        </ul>
    </div>

    <div class="resources-group">
        <h2>Publishers</h2>
        <ul class="plain-list">
            <li><a href="https://www.augsburgfortress.org" target="_blank" rel="noopener">Augsburg Fortress ↗</a></li>
            <li><a href="https://www.giamusic.com" target="_blank" rel="noopener">GIA Publications ↗</a></li>
            <li><a href="https://www.morningstarmusic.com" target="_blank" rel="noopener">MorningStar Music ↗</a></li>
            <li><a href="https://www.cph.org" target="_blank" rel="noopener">Concordia Publishing House ↗</a></li>
            <li><a href="https://www.choristersguild.org" target="_blank" rel="noopener">Choristers Guild ↗</a></li>
            <li><a href="https://www.halleonard.com" target="_blank" rel="noopener">Hal Leonard ↗</a></li>
        </ul>
    </div>

    <div class="resources-group">
        <h2>Retailers</h2>
        <ul class="plain-list">
            <li><a href="https://www.jwpepper.com" target="_blank" rel="noopener">J.W. Pepper ↗</a></li>
            <li><a href="https://www.sheetmusicplus.com" target="_blank" rel="noopener">Sheet Music Plus ↗</a></li>
            <li><a href="https://www.musicnotes.com" target="_blank" rel="noopener">Musicnotes ↗</a></li>
        </ul>
    </div>
</div>
