<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FCNX3PTLV4"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-FCNX3PTLV4');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (function () {
            var saved = localStorage.getItem('hymn-desk-theme');
            var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        })();
    </script>
    @{
        var rawTitle = ViewData["Title"]?.ToString() ?? "";
        var fullTitle = ViewData["FullTitle"]?.ToString()
            ?? (string.IsNullOrEmpty(rawTitle) || rawTitle == "Hymn Desk"
                ? "Hymn Desk – Lutheran Hymn Texts, Tunes & Hymnal Numbers"
                : rawTitle + " | Hymn Desk");
        var metaDesc = ViewData["Description"]?.ToString() ?? Seo.DefaultDescription;
        var reqPath = Context.Request.Path.Value ?? "/";
        var canonical = Seo.BaseUrl + (reqPath == "/" ? "/" : reqPath.TrimEnd('/'));
    }
    <title>@fullTitle</title>
    <meta name="description" content="@metaDesc" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:site_name" content="Hymn Desk" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:url" content="@canonical" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

<header class="site-header">
    <div class="site-header-inner">
        <a href="/" class="wordmark">Hymn Desk</a>
        <nav class="site-nav">
            <details class="nav-dropdown">
                <summary>Browse</summary>
                <div class="nav-dropdown-menu">
                    <a href="/hymns">Hymn Texts</a>
                    <a href="/tunes">Hymn Tunes</a>
                    <a href="/people">People</a>
                    <a href="/people/countries">People by Country</a>
                    <a href="/first-lines">First Line Index</a>
                    <a href="/meters">Meter Index</a>
                    <a href="/law-gospel">Law/Gospel Index</a>
                    <a href="/compare-hymnals">Compare Hymnals</a>
                    <a href="/hymns/random">Random Hymn</a>
                </div>
            </details>
            <details class="nav-dropdown">
                <summary>Reference</summary>
                <div class="nav-dropdown-menu">
                    <a href="/bible">Bible Lookup</a>
                    <a href="/lectionary">Lectionary Planner</a>
                    <a href="/hymn-of-the-day">Hymn of the Day Calendar</a>
                    <a href="/devotions">Devotions</a>
                    <a href="/bach-cantatas">Bach Cantatas</a>
                    <a href="/glossary">Glossary</a>
                    <a href="/confessions">Confessions &amp; Catechisms</a>
                    <a href="/timeline">Historical Timeline</a>
                    <a href="/calendar-wheel">Liturgical Calendar Wheel</a>
                    <a href="/topics">Topical Index</a>
                    <a href="/service-builder">Service Builder</a>
                </div>
            </details>
        </nav>
        <form action="/hymns" method="get" class="header-search">
            <input type="search" name="q" placeholder="Search hymns, tunes, people…" />
            <button type="submit">Search</button>
        </form>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <span class="theme-icon-dark">☾</span>
            <span class="theme-icon-light">☀</span>
        </button>
    </div>
</header>

<main class="site-main">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="site-footer-inner">
        <nav class="footer-nav">
            <a href="/about">About</a>
            <a href="/resources">Resources</a>
            <a href="/donate">Support Hymn Desk</a>
        </nav>
        <p>Hymn Desk — a personal sacred music reference database.</p>
        <p class="footer-note">All hymn texts and tunes are public domain unless otherwise noted. PHH notes paraphrased from <em>Psalter Hymnal Handbook</em>.</p>
    </div>
</footer>

<script>
    document.querySelectorAll('.nav-dropdown').forEach(function (dd) {
        dd.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () { dd.open = false; });
        });
    });
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.nav-dropdown[open]').forEach(function (dd) {
            if (!dd.contains(e.target)) dd.open = false;
        });
    });

    document.getElementById('theme-toggle').addEventListener('click', function () {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (isDark) {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('hymn-desk-theme', 'light');
        } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('hymn-desk-theme', 'dark');
        }
    });
</script>
</body>
</html>
