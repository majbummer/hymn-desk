<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] — Hymn Desk Admin</title>
    <style>
        :root { --bg:#faf8f4; --fg:#2a2420; --muted:#7a6f66; --line:#ddd5ca; --card:#fff; --accent:#7a2e2e; --accent-fg:#fff; --warn:#fff3cd; --warn-fg:#6b5200; --ok:#e3f3e3; --ok-fg:#1d5a1d; --err:#fbe4e4; --err-fg:#8a1c1c; }
        @@media (prefers-color-scheme: dark) {
            :root { --bg:#1c1a18; --fg:#ece6de; --muted:#a39a90; --line:#3a3530; --card:#262320; --accent:#d98a8a; --accent-fg:#1c1a18; --warn:#3d3312; --warn-fg:#f0d98a; --ok:#1f3a1f; --ok-fg:#a8e0a8; --err:#4a2222; --err-fg:#f2b0b0; }
        }
        * { box-sizing: border-box; }
        body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
        a { color:var(--accent); }
        .bar { display:flex; align-items:center; gap:14px; padding:10px 20px; border-bottom:1px solid var(--line); background:var(--card); }
        .brand { font-weight:700; text-decoration:none; font-size:17px; }
        .tag { font-size:12px; background:var(--warn); color:var(--warn-fg); padding:2px 8px; border-radius:10px; }
        .site-link { margin-left:auto; font-size:13px; }
        main { max-width:1200px; margin:0 auto; padding:20px; }
        h1 { font-size:24px; margin:4px 0 12px; }
        .muted { color:var(--muted); }
        .crumbs { font-size:13px; color:var(--muted); margin:0; }
        .note { background:var(--warn); color:var(--warn-fg); padding:10px 14px; border-radius:8px; margin:12px 0; font-size:14px; }
        .ok { background:var(--ok); color:var(--ok-fg); padding:10px 14px; border-radius:8px; margin:12px 0; }
        .err { background:var(--err); color:var(--err-fg); padding:10px 14px; border-radius:8px; margin:12px 0; }
        .quick { display:flex; flex-wrap:wrap; gap:8px; margin:12px 0 20px; }
        .btn { display:inline-block; padding:7px 14px; border:1px solid var(--accent); border-radius:6px; background:var(--accent); color:var(--accent-fg); text-decoration:none; font:inherit; cursor:pointer; }
        .btn.secondary { background:transparent; color:var(--accent); }
        .btn.danger { background:transparent; color:var(--err-fg); border-color:var(--err-fg); }
        table.grid { border-collapse:collapse; width:100%; background:var(--card); font-size:13.5px; }
        table.grid th, table.grid td { border:1px solid var(--line); padding:5px 8px; text-align:left; vertical-align:top; }
        table.grid th { background:var(--bg); position:sticky; top:0; white-space:nowrap; }
        .scroll { overflow-x:auto; }
        .null { color:var(--muted); font-style:italic; }
        .toolbar { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:10px 0; }
        input[type=text], input[type=search], select, textarea { width:100%; padding:7px 9px; border:1px solid var(--line); border-radius:6px; background:var(--card); color:var(--fg); font:inherit; }
        .toolbar input[type=search] { width:280px; }
        textarea { min-height:130px; resize:vertical; }
        .field { margin:0 0 14px; }
        .field label { display:block; font-weight:600; margin-bottom:3px; }
        .hint { font-size:12px; color:var(--muted); margin-top:2px; }
        .form-card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:18px; max-width:820px; }
        .actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:18px; }
        .related { margin:18px 0; padding:12px 14px; border:1px solid var(--line); border-radius:8px; background:var(--card); max-width:820px; }
        .related h2 { font-size:15px; margin:0 0 6px; }
        .related li { margin:2px 0; }
        .pager { display:flex; gap:12px; align-items:center; margin:12px 0; }
        .readonly { padding:7px 9px; background:var(--bg); border:1px dashed var(--line); border-radius:6px; }
    </style>
</head>
<body>
<header class="bar">
    <a href="/admin" class="brand">Hymn Desk Admin</a>
    <span class="tag">local only</span>
    <a href="/" class="site-link">View site →</a>
</header>
<main>
    @RenderBody()
</main>
</body>
</html>
