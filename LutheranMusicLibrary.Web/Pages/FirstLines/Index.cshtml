@page "/first-lines"
@model LutheranMusicLibrary.Web.Pages.FirstLines.IndexModel
@{ ViewData["Title"] = "First Line Index"; }

<div class="page-header">
    <h1>First Line Index</h1>
    <p class="page-subtitle">
        @Model.Hymns.Count.ToString("N0") entries · Find a hymn by its opening words,
        the way most printed hymnals index them.
    </p>
</div>

<div class="filter-bar">
    <form method="get" class="filter-form">
        <input type="search" name="q" value="@Model.Query" placeholder="Search first lines or titles…" class="filter-input" />
        <button type="submit" class="filter-btn">Filter</button>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <a href="/first-lines" class="filter-clear">Clear</a>
        }
    </form>
</div>

<div class="firstline-list">
    @foreach (var hymn in Model.Hymns)
    {
        <a href="/hymns/@hymn.Slug" class="firstline-row">
            <span class="firstline-text">@hymn.FirstLine</span>
            @if (!string.Equals(hymn.FirstLine, hymn.Title, StringComparison.OrdinalIgnoreCase))
            {
                <span class="firstline-title">@hymn.Title</span>
            }
        </a>
    }
</div>
